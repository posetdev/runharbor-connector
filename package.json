{
  "name": "@runharbor/connector",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "workspaces": ["packages/*"],
  "scripts": {
    "check": "tsc --noEmit && node scripts/check-layers.mjs && node scripts/check-docs.mjs && npm run test:unit && npm run test:contract",
    "test:unit": "node --import tsx --test 'test/unit/**/*.test.ts'",
    "test:contract": "node --import tsx --test 'test/contract/**/*.test.ts'",
    "test:integration": "node --import tsx --test 'test/integration/**/*.test.ts'",
    "test:package": "node --import tsx --test 'test/package/**/*.test.ts'",
    "test:linux-bootstrap": "/usr/bin/python3 bootstrap/test/linux_x64_claim_test.py && node --test bootstrap/test/linux-x64-claim.test.mjs && bash bootstrap/test/linux-x64-shell-gate.sh && bash bootstrap/test/linux-x64-user-data-gate.sh"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1129.0",
    "@aws-sdk/client-ec2": "^3.1129.0",
    "@aws-sdk/client-scheduler": "^3.1129.0",
    "@aws-sdk/client-ssm": "^3.1129.0",
    "@aws-sdk/lib-dynamodb": "^3.1129.0",
    "@smithy/node-http-handler": "4.12.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "esbuild": "0.25.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
