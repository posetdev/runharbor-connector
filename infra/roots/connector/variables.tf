variable "aws_region" {
  type        = string
  description = "AWS region to deploy the Connector into."

  validation {
    condition     = can(regex("^[a-z]{2}(-[a-z]+)+-[0-9]$", var.aws_region))
    error_message = "aws_region must be a valid AWS region name."
  }
}

variable "name_prefix" {
  type        = string
  description = "Prefix for all resource names created by this deployment."
}

variable "deployment_id" {
  type        = string
  description = "Deployment id from deployment.json."
}

variable "tenant_id" {
  type        = string
  description = "Tenant id from deployment.json."
}

variable "saas_public_key" {
  type        = string
  description = "Pinned SaaS keyset-root Ed25519 public key (base64 SPKI) from deployment.json. It verifies the well-known command-key document signature and is not a command-signing key."
}

variable "gitee_workflow" {
  description = "Gitee binding workflow configuration."
  type = object({
    workflowFile = string
    ref          = string
  })
  default = null
}

variable "saas_origin" {
  type        = string
  description = "SaaS origin from deployment.json."
}

variable "webhook_url" {
  type        = string
  description = "GitHub webhook delivery URL for this deployment, from deployment.json."
}

variable "github_app_organization" {
  type = object({
    id    = string
    login = string
    type  = string
  })
  description = "Verified GitHub Organization that must own the GitHub App, from deployment.json."
}

variable "installer_public_key" {
  type        = string
  description = "Base64 SPKI Ed25519 public key generated by `runharbor init`."
}

variable "images" {
  description = "Runner image settings keyed by runner architecture. There is no AMI id to supply: the host is Canonical's Ubuntu 24.04 LTS, and the module resolves its current AMI per architecture from Canonical's public SSM parameters at deploy time."
  type = map(object({
    root_volume_gib      = number
    max_duration_minutes = number
  }))
}

variable "allowed_instance_types" {
  description = "EC2 instance types the Connector may launch; this is enforced both before launch and by IAM."
  type        = list(string)
}

variable "purchase_mode" {
  description = "How runner instances are bought. Spot is 43-49% cheaper here and matches what the pool these runners replace already paid; on-demand is the escape hatch for when Spot capacity refuses a launch."
  type        = string
  default     = "spot"

  validation {
    condition     = contains(["spot", "on-demand"], var.purchase_mode)
    error_message = "purchase_mode must be \"spot\" or \"on-demand\"."
  }
}


variable "log_retention_days" {
  type        = number
  description = "CloudWatch Logs retention for all Lambda log groups."
  default     = 14
}

variable "orphan_sweep_enabled" {
  type        = bool
  description = "Enable the hourly orphan-instance sweep rule."
  default     = true
}

variable "lambda_artifact_dir" {
  type        = string
  description = "Directory containing the packaged Lambda zips. Defaults to dist/lambda built by scripts/package-lambda.mjs."
  default     = null
}
