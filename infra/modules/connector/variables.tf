variable "name_prefix" {
  type        = string
  description = "Prefix for all resource names created by this module."

  validation {
    condition     = can(regex("^[a-z][a-z0-9-]{2,30}$", var.name_prefix))
    error_message = "name_prefix must match ^[a-z][a-z0-9-]{2,30}$."
  }
}

variable "deployment_id" {
  type        = string
  description = "Deployment id issued by the SaaS control plane (deployment.json)."

  validation {
    condition     = can(regex("^dep_[0-9a-f]{24}$", var.deployment_id))
    error_message = "deployment_id must match ^dep_[0-9a-f]{24}$."
  }
}

variable "tenant_id" {
  type        = string
  description = "RunHarbor organization (tenant) id from deployment.json."

  validation {
    condition     = can(regex("^[a-z0-9][a-z0-9-]{0,62}$", var.tenant_id))
    error_message = "tenant_id must match ^[a-z0-9][a-z0-9-]{0,62}$."
  }
}

variable "saas_public_key" {
  type        = string
  description = "Pinned SaaS keyset-root Ed25519 public key (base64 SPKI) from deployment.json. Fetched command-key documents are accepted only when this exact root verifies their detached signature. It is not a rotating command key."

  validation {
    condition     = can(regex("^[A-Za-z0-9+/]+={0,2}$", var.saas_public_key))
    error_message = "saas_public_key must be base64-encoded."
  }
}

variable "gitee_workflow" {
  description = "Gitee binding workflow configuration."
  type = object({
    workflowFile = string
    ref          = string
  })
  default = null
}

variable "saas_origin" {
  type        = string
  description = "HTTPS origin of the SaaS control plane, from deployment.json."

  validation {
    condition     = can(regex("^https://", var.saas_origin))
    error_message = "saas_origin must be an https:// URL."
  }
}

variable "webhook_url" {
  type        = string
  description = "GitHub webhook delivery URL for this deployment, copied verbatim from deployment.json. Opaque to the connector: never derive it from saas_origin."

  validation {
    condition     = startswith(var.webhook_url, "https://")
    error_message = "webhook_url must be an https URL."
  }
}

variable "github_app_organization" {
  description = "Verified GitHub Organization that must own the customer-created GitHub App, copied by the CLI from deployment.json."
  type = object({
    id    = string
    login = string
    type  = string
  })

  validation {
    condition     = can(regex("^[1-9][0-9]{0,15}$", var.github_app_organization.id)) && can(regex("^[A-Za-z0-9_.-]{1,100}$", var.github_app_organization.login)) && var.github_app_organization.type == "Organization"
    error_message = "github_app_organization must be a verified GitHub Organization id, login, and type."
  }
}

variable "installer_public_key" {
  type        = string
  description = "Base64-encoded SPKI Ed25519 public key generated by the customer CLI (runharbor init)."

  validation {
    condition     = can(regex("^[A-Za-z0-9+/]+={0,2}$", var.installer_public_key))
    error_message = "installer_public_key must be base64-encoded."
  }
}

variable "images" {
  description = "Runner image settings keyed by runner architecture. There is no AMI id to supply: the host is one distribution, Canonical's Ubuntu 24.04 LTS, and this module resolves its current AMI per architecture from Canonical's public SSM parameters (see locals.tf). Only the settings that are not properties of that image belong here. Every image shares the module's runner role, security group and subnets."
  type = map(object({
    root_volume_gib      = number
    max_duration_minutes = number
  }))

  validation {
    condition     = length(var.images) > 0
    error_message = "at least one image is required."
  }

  validation {
    condition     = alltrue([for key, _ in var.images : contains(["x64", "arm64"], key)])
    error_message = "image keys must be x64 or arm64."
  }

  validation {
    condition     = alltrue([for _, image in var.images : image.root_volume_gib >= 1])
    error_message = "images[*].root_volume_gib must be at least 1."
  }

  validation {
    condition     = alltrue([for _, image in var.images : image.max_duration_minutes > 0])
    error_message = "images[*].max_duration_minutes must be positive."
  }
}

variable "allowed_instance_types" {
  description = "EC2 instance types that may be requested by the SaaS; IAM enforces this same list as the final launch boundary."
  type        = list(string)
  validation {
    condition     = length(var.allowed_instance_types) > 0 && alltrue([for instance_type in var.allowed_instance_types : can(regex("^[a-z0-9-]+\\.[a-z0-9-]+$", instance_type))])
    error_message = "allowed_instance_types must contain EC2 instance-type names."
  }

  validation {
    condition     = contains(var.allowed_instance_types, "c7g.xlarge") && contains(var.allowed_instance_types, "c7i.large")
    error_message = "allowed_instance_types must include c7g.xlarge and c7i.large."
  }
}

variable "purchase_mode" {
  description = "How runner instances are bought. Spot is 43-49% cheaper here and matches what the pool these runners replace already paid; on-demand is the escape hatch for when Spot capacity refuses a launch."
  type        = string
  default     = "spot"

  validation {
    condition     = contains(["spot", "on-demand"], var.purchase_mode)
    error_message = "purchase_mode must be \"spot\" or \"on-demand\"."
  }
}


variable "log_retention_days" {
  type        = number
  description = "CloudWatch Logs retention for all Lambda log groups."
  default     = 14

  validation {
    condition     = var.log_retention_days > 0
    error_message = "log_retention_days must be positive."
  }
}

variable "orphan_sweep_enabled" {
  type        = bool
  description = "Enable the hourly orphan-instance sweep rule."
  default     = true
}

variable "lambda_artifact_dir" {
  type        = string
  description = "Directory containing start.zip, runner.zip, setup.zip and timeout.zip built by scripts/package-lambda.mjs."
  default     = null
}

locals {
  lambda_artifact_dir = coalesce(var.lambda_artifact_dir, "${path.module}/../../../dist/lambda")
}
